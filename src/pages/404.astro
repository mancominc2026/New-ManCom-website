---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Page not found">
  <section class="section nf">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>We couldn't find that page.</h1>
      <p class="lede">The link may be out of date. Try one of these instead, or call us at <a href={site.phoneHref}>{site.phone}</a>.</p>
      <div class="nf__actions">
        <a class="btn btn--secondary" href="/">Home</a>
        <a class="btn btn--outline" href="/services/">Services</a>
        <a class="btn btn--outline" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .nf a:not(.btn) {
    color: var(--brand);
    font-weight: 600;
  }
  .nf__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
</style>
