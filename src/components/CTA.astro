---
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Talk to an engineer today',
  text = 'No sales runaround. Call us or send a note and a ManCom engineer will get back to you quickly — day or night.',
} = Astro.props;
---

<section class="cta">
  <div class="container cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href={site.phoneHref}><Icon name="phone" size={18} /> Call {site.phone}</a>
      <a class="btn btn--ghost" href="/contact/">Request a quote</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-700) 100%);
    color: var(--navy-100);
    padding-block: clamp(48px, 7vw, 80px);
  }
  .cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .cta h2 {
    color: var(--white);
    margin-bottom: 8px;
  }
  .cta p {
    margin: 0;
    max-width: 56ch;
    opacity: 0.85;
  }
  .cta__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
